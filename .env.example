# ─────────────────────────────────────────────────────────────────────────────
# 环境变量示例。复制为 .env.local（本地）或填到部署平台的环境变量面板。
# 以 VITE_ 开头的变量会被打包进前端产物，**绝不能**放任何密钥。
# ─────────────────────────────────────────────────────────────────────────────

# ── 截图识别端点（可选，前端）─────────────────────────────────────────────────
# 前端调用的识别端点地址。部署到 Vercel 后一般填 /api/recognize；
# 留空时前端使用内置演示识别数据兜底。
VITE_RECOGNIZE_ENDPOINT=
# 该端点的鉴权令牌（前端侧）。仅当你确实要用服务端识别端点、且接受
# 「令牌会被打包进前端」这一事实时才配置；更推荐用「AI 设置」里的自带密钥视觉模型。
VITE_RECOGNIZE_TOKEN=

# ── 截图识别端点（服务端，api/recognize.ts）──────────────────────────────────
# 端点鉴权令牌。**未配置时端点一律返回 503（等同下线）**——这是有意的安全默认值：
# 否则任何人都能白嫖你的付费大模型额度。
RECOGNIZE_TOKEN=
# 允许调用该端点的来源域名（逗号分隔，支持 *.example.com 通配）。留空则不校验来源。
RECOGNIZE_ALLOWED_ORIGINS=
# 识别服务商：qwen（阿里云百炼，默认）或 openai。
RECOGNIZE_PROVIDER=qwen
# 对应服务商的密钥（按 RECOGNIZE_PROVIDER 填其一即可）。
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# ── AI 代理（api/ai-chat、api/ai-models、_worker.js、vite dev 插件）──────────
# 额外允许转发的主机白名单（逗号分隔，支持 *.example.com）。
# 内置已放行：api.deepseek.com / dashscope.aliyuncs.com / open.bigmodel.cn / api.openai.com。
# 只有你要接自建网关时才需要在这里追加。
AI_PROXY_ALLOWED_HOSTS=

# ── Cloudflare Worker（_worker.js）──────────────────────────────────────────
# 额外允许跨域访问代理的来源（逗号分隔）。请求同源始终放行。
# Worker 不会下发 Access-Control-Allow-Origin: *。
CORS_ALLOWED_ORIGINS=
